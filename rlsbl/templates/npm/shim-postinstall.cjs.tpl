// Auto-generated by rlsbl -- launcher postinstall shim.
//
// Downloads the wrapped binary from its GitHub Release at `npm install`
// time, verifies its SHA-256 against the release's checksums.txt, and
// installs it into this package's vendor/ directory. Node stdlib only --
// zero runtime dependencies.
//
// Baked-in values (resolved from the wrapped producer pipeline at scaffold
// time). goreleaser default asset naming is assumed:
//   <PROJECT>_<VERSION>_<OS>_<ARCH>.<ext>  and  checksums.txt
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const https = require("https");
const crypto = require("crypto");
const { execFileSync } = require("child_process");

const GITHUB_REPO = "{{githubRepo}}";
const ASSET_PROJECT = "{{assetProject}}";
const BINARY_NAME = "{{binaryName}}";

// process.platform/arch -> goreleaser (Os, Arch) naming.
const OS_MAP = { linux: "linux", darwin: "darwin", win32: "windows" };
const ARCH_MAP = { x64: "amd64", arm64: "arm64" };

function targetTriple() {
  const goos = OS_MAP[process.platform];
  const goarch = ARCH_MAP[process.arch];
  if (!goos || !goarch) {
    throw new Error(
      `Unsupported platform: ${process.platform}/${process.arch}. ` +
        `Supported: linux|darwin|windows x amd64|arm64.`
    );
  }
  const ext = goos === "windows" ? "zip" : "tar.gz";
  return { goos, goarch, ext };
}

function assetName(version) {
  const { goos, goarch, ext } = targetTriple();
  return `${ASSET_PROJECT}_${version}_${goos}_${goarch}.${ext}`;
}

function releaseBaseUrl(version) {
  return `https://github.com/${GITHUB_REPO}/releases/download/v${version}`;
}

// Download a URL to a Buffer, following GitHub's redirect to the CDN.
function download(url, redirectsLeft = 5) {
  return new Promise((resolve, reject) => {
    https
      .get(url, { headers: { "User-Agent": "rlsbl-launcher" } }, (res) => {
        const { statusCode, headers } = res;
        if (statusCode >= 300 && statusCode < 400 && headers.location) {
          res.resume();
          if (redirectsLeft <= 0) {
            reject(new Error(`Too many redirects for ${url}`));
            return;
          }
          resolve(download(headers.location, redirectsLeft - 1));
          return;
        }
        if (statusCode === 404) {
          res.resume();
          reject(new Error(`Asset not found (HTTP 404): ${url}`));
          return;
        }
        if (statusCode !== 200) {
          res.resume();
          reject(new Error(`Download failed (HTTP ${statusCode}): ${url}`));
          return;
        }
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => resolve(Buffer.concat(chunks)));
        res.on("error", reject);
      })
      .on("error", reject);
  });
}

// Parse a goreleaser checksums.txt ("<sha256>  <filename>" per line) and
// return the expected hex digest for `name`, or null if absent.
function expectedDigest(checksumsText, name) {
  for (const line of checksumsText.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    const parts = trimmed.split(/\s+/);
    if (parts.length >= 2 && parts[parts.length - 1] === name) {
      return parts[0].toLowerCase();
    }
  }
  return null;
}

function sha256(buffer) {
  return crypto.createHash("sha256").update(buffer).digest("hex");
}

// Verify `buffer` against the checksums file. Throws on mismatch or a
// missing checksum line -- a hard failure, never a silent pass.
function verifyChecksum(buffer, checksumsText, name) {
  const expected = expectedDigest(checksumsText, name);
  if (!expected) {
    throw new Error(`No checksum entry for ${name} in checksums.txt`);
  }
  const actual = sha256(buffer);
  if (actual !== expected) {
    throw new Error(
      `Checksum mismatch for ${name}: expected ${expected}, got ${actual}`
    );
  }
  return true;
}

function extractBinary(archivePath, destDir, ext) {
  fs.mkdirSync(destDir, { recursive: true });
  // Use the system tar (bsdtar on Windows 10+, GNU/bsd tar elsewhere). It
  // handles both .tar.gz and .zip. child_process is Node stdlib -- no
  // third-party tar dependency.
  execFileSync("tar", ["-xf", archivePath, "-C", destDir], {
    stdio: "inherit",
  });
}

function installedBinaryPath() {
  // goreleaser names the binary inside the archive after the project name
  // (ASSET_PROJECT), which may differ from the exposed command name.
  const exe = process.platform === "win32" ? ".exe" : "";
  return path.join(__dirname, "..", "vendor", ASSET_PROJECT + exe);
}

async function main() {
  const pkg = require(path.join(__dirname, "..", "package.json"));
  const version = pkg.version;
  const name = assetName(version);
  const base = releaseBaseUrl(version);

  console.log(`[${BINARY_NAME}] downloading ${name} from ${GITHUB_REPO}...`);
  const assetBuf = await download(`${base}/${name}`);
  const checksumsBuf = await download(`${base}/checksums.txt`);

  // Verify BEFORE writing anything into the package.
  verifyChecksum(assetBuf, checksumsBuf.toString("utf8"), name);
  console.log(`[${BINARY_NAME}] checksum verified.`);

  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "rlsbl-launcher-"));
  const archivePath = path.join(tmpDir, name);
  fs.writeFileSync(archivePath, assetBuf);

  const vendorDir = path.join(__dirname, "..", "vendor");
  const { ext } = targetTriple();
  extractBinary(archivePath, vendorDir, ext);

  const binPath = installedBinaryPath();
  if (!fs.existsSync(binPath)) {
    throw new Error(
      `Extracted archive did not contain expected binary: ${binPath}`
    );
  }
  if (process.platform !== "win32") {
    fs.chmodSync(binPath, 0o755);
  }
  fs.rmSync(tmpDir, { recursive: true, force: true });
  console.log(`[${BINARY_NAME}] installed ${binPath}`);
}

module.exports = {
  targetTriple,
  assetName,
  releaseBaseUrl,
  expectedDigest,
  sha256,
  verifyChecksum,
  download,
  extractBinary,
  installedBinaryPath,
  main,
};

if (require.main === module) {
  main().catch((err) => {
    console.error(`[${BINARY_NAME}] postinstall failed: ${err.message}`);
    process.exit(1);
  });
}
