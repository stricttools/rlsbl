              "negatable": true,
              "hidden": false
            }
          ],
          "args": [],
          "passthrough": false
        },
        "generate": {
          "name": "generate",
          "help": "Compile all validated JSONL changelog entries into a formatted CHANGELOG.md file. Groups entries by type (features, fixes, breaking changes) under the appropriate version heading, preserving existing changelog content for previous releases. Use --dry-run to preview the generated Markdown output without writing to disk, which is useful for reviewing before committing.",
          "flags": [
