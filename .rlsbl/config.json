{
  "publish_mode": "ci",
  "env_file": "~/Projects/.env",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": [
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 3
          }
        ]
      },
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 4
          }
        ]
      }
    ]
  },
  "targets": [
    "npm",
    "pypi"
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    },
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    }
  },
  "changelog_format_version_enforced": true,
  "internal_dep_floors": [
    "strictcli",
    "strictspec",
    "selfdoc-core"
  ],
  "test_sandbox": {
    "runner_path": "scripts/test.sh",
    "command": "uv sync --offline $SANDBOX_UV_SYNC_ARGS && eval \"$SANDBOX_OVERLAY_INSTALL\" && uv run $SANDBOX_UV_RUN_ARGS --offline pytest",
    "default_args": "-q -n auto",
    "caches": [
      "uv",
      "go",
      "python_user_base"
    ],
    "prewarm": [
      "scripts/test-prewarm.sh"
    ],
    "ci_workflows": [
      ".github/workflows/ci-pypi.yml"
    ]
  }
}
