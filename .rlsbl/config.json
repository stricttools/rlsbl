{
  "publish_mode": "ci",
  "env_file": "~/Projects/.env",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": [
      {
        "reason": "**Breaking.** Migrated check system from CheckResult to strictcli's reporter-based check API (ErrorReporter/WarnReporter + CheckOutcome).",
        "entries": [
          {
            "version": "unreleased",
            "line": 43
          }
        ]
      }
    ]
  },
  "targets": [
    "npm",
    "pypi"
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    },
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    },
    "docs-deploy": {
      "type": "cloudflare-pages",
      "local": true,
      "target": null
    }
  },
  "coverage_unit": "commit"
}
