{
  "publish_mode": "ci",
  "env_file": "~/Projects/.env",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": []
  },
  "targets": [
    "npm",
    "pypi"
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    },
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    },
    "docs-deploy": {
      "type": "cloudflare-pages",
      "local": true,
      "target": null
    }
  },
  "changelog_format_version_enforced": true,
  "internal_dep_floors": [
    "strictcli",
    "strictspec",
    "selfdoc-core"
  ],
  "test_sandbox": {
    "runner_path": "scripts/test.sh",
    "command": "uv sync --offline && uv run --offline pytest",
    "default_args": "-q -n auto",
    "caches": [
      "uv",
      "go",
      "python_user_base"
    ],
    "prewarm": [
      "scripts/test-prewarm.sh"
    ],
    "ci_workflows": [
      ".github/workflows/ci-pypi.yml"
    ]
  }
}
