{
  "private": false,
  "env_file": "~/Projects/.env",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": [
      {
        "reason": "Documentation overhaul: 13 commits for one cohesive feature",
        "entries": [{"version": "unreleased", "line": 2}]
      }
    ]
  },
  "targets": [
    "npm",
    "pypi"
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false
    },
    "pypi": {
      "type": "pypi",
      "local": false
    },
    "docs-deploy": {
      "type": "cloudflare-pages",
      "local": true
    }
  }
}
