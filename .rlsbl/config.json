{
  "private": false,
  "env_file": "~/Projects/.env",
  "push_timeout": 120,
  "batch_limits": {
    "exclusions": [
      {
        "reason": "non-user-facing batch",
        "entries": [
          {
            "version": "unreleased",
            "line": 3
          }
        ]
      }
    ]
  },
  "targets": [
    "npm",
    "pypi"
  ],
  "pipelines": {
    "npm": {
      "type": "npm",
      "local": false
    },
    "pypi": {
      "type": "pypi",
      "local": false
    },
    "docs-deploy": {
      "type": "cloudflare-pages",
      "local": true
    }
  }
}
