{
  "version": "0.81.1",
  "base_url": "https://rlsbl.smmh.dev",
  "source": [
    {
      "path": "rlsbl/",
      "language": "python"
    }
  ],
  "docs": "docs/",
  "output": "docs/_build/",
  "versions": [
    {
      "version": "0.81.1",
      "indexed": true
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "deploy": {
    "provider": "cloudflare-pages",
    "project": "rlsbl-docs"
  },
  "gen": {
    "exclude": [
      "rlsbl.changelog",
      "rlsbl.commands.monorepo"
    ]
  },
  "root_files": [
    "docs/_CLAUDE.md",
    "docs/_README.md"
  ],
  "directives": {
    "table-feature-matrix": "docs/directives/feature_matrix.py",
    "table-pipelines": "docs/directives/pipeline_table.py",
    "table-targets": "docs/directives/target_table.py",
    "check-count": "docs/directives/check_count.py",
    "target-count": "docs/directives/target_count.py"
  },
  "topology": {
    "slug": "rlsbl",
    "docs_base": "https://docs.smmh.dev",
    "posts_base": "https://blog.smmh.dev",
    "assembly": "smm-h/selfdoc-cache",
    "projects": {
      "pixelweaver": "https://docs.smmh.dev/pixelweaver",
      "claudestream": "https://docs.smmh.dev/claudestream",
      "claudewheel": "https://docs.smmh.dev/claudewheel",
      "go-toml-edit": "https://docs.smmh.dev/go-toml-edit",
      "howmuchleft": "https://docs.smmh.dev/howmuchleft",
      "migrable": "https://docs.smmh.dev/migrable",
      "orxt": "https://docs.smmh.dev/orxt",
      "pgdesign": "https://docs.smmh.dev/pgdesign",
      "predraw": "https://docs.smmh.dev/predraw",
      "safegit": "https://docs.smmh.dev/safegit",
      "saferm": "https://docs.smmh.dev/saferm",
      "selfdoc": "https://docs.smmh.dev/selfdoc",
      "strictcli": "https://docs.smmh.dev/strictcli",
      "wesktop": "https://docs.smmh.dev/wesktop"
    }
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  }
}
