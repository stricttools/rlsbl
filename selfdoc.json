{
  "version": "0.121.4",
  "base_url": "https://smmh.dev/rlsbl",
  "description": "Release orchestration and project scaffolding CLI that bumps versions, validates a structured JSONL changelog, tags only the commit CI verified, and publishes to npm, PyPI, Go and more",
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "source": [
    {
      "path": "rlsbl/",
      "language": "python"
    }
  ],
  "docs": ".stricttools/docs/",
  "output": ".stricttools/docs-cache/build/",
  "versions": [
    {
      "version": "0.121.4"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "gen": {
    "exclude": [
      "rlsbl.changelog",
      "rlsbl.commands.monorepo",
      "rlsbl.strictspec_gen*"
    ]
  },
  "root_files": [
    ".stricttools/docs/_CLAUDE.md",
    ".stricttools/docs/_README.md"
  ],
  "directives": {
    "table-feature-matrix": ".stricttools/docs/directives/feature_matrix.py",
    "table-pipelines": ".stricttools/docs/directives/pipeline_table.py",
    "table-targets": ".stricttools/docs/directives/target_table.py",
    "table-target-axes": ".stricttools/docs/directives/target_axes.py",
    "check-count": ".stricttools/docs/directives/check_count.py",
    "table-check-tags": ".stricttools/docs/directives/check_tags.py",
    "target-count": ".stricttools/docs/directives/target_count.py"
  },
  "topology": {
    "slug": "rlsbl",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "posts": {
    "repo": "smm-h/posts"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  }
}
