{
  "version": "0.132.1",
  "base_url": "https://smmh.dev/rlsbl",
  "description": "Release orchestration and project scaffolding CLI that bumps versions, validates a structured JSONL changelog, tags only the commit CI verified, and publishes to npm, PyPI, and the Go module proxy",
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "source": [
    {
      "path": "cmd/rlsbl",
      "language": "go"
    },
    {
      "path": "internal",
      "language": "go"
    }
  ],
  "docs": ".strictmetadata/docs/",
  "output": ".strictmetadata/.docs-cache/build/",
  "versions": [
    {
      "version": "0.132.1"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "gen": {
    "exclude": [
      "testsupport",
      "*spec",
      "gen",
      "privatepathscheck"
    ]
  },
  "root_files": [
    {
      "template": ".strictmetadata/docs/_CLAUDE.md",
      "outputs": [
        ".claude/CLAUDE.md"
      ]
    },
    {
      "template": ".strictmetadata/docs/_README.md",
      "outputs": [
        "README.md"
      ]
    }
  ],
  "directives": {
    "table-targets": ".strictmetadata/docs/directives/target_table.py",
    "table-target-axes": ".strictmetadata/docs/directives/target_axes.py",
    "check-count": ".strictmetadata/docs/directives/check_count.py",
    "table-check-tags": ".strictmetadata/docs/directives/check_tags.py",
    "table-checks": ".strictmetadata/docs/directives/check_table.py",
    "table-pipelines": ".strictmetadata/docs/directives/pipeline_table.py"
  },
  "topology": {
    "slug": "rlsbl",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "posts": {
    "repo": "smm-h/posts"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  }
}
