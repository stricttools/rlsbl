{
  "version": "0.57.1",
  "base_url": "https://rlsbl.smmh.dev",
  "source": [
    {
      "path": "rlsbl/",
      "language": "python"
    }
  ],
  "docs": "docs/",
  "output": "docs/_build/",
  "versions": [
    {
      "version": "0.57.1",
      "indexed": true
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "deploy": {
    "provider": "cloudflare-pages",
    "project": "rlsbl-docs"
  },
  "gen": {
    "exclude": [
      "rlsbl.changelog",
      "rlsbl.commands.monorepo"
    ]
  },
  "root_files": [
    "docs/_CLAUDE.md",
    "docs/_README.md"
  ]
}
